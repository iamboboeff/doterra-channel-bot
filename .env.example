# ── Два бота от @BotFather ──────────────────────────────────────────────
# Бот для участников (его дают людям: Start → ID → доступ в канал)
MEMBER_BOT_TOKEN=123:ABC...
# Админ-бот (только для тебя: меню, загрузка CSV, удаление)
ADMIN_BOT_TOKEN=456:DEF...

# ── Канал ───────────────────────────────────────────────────────────────
# ID закрытого канала. Оба бота должны быть в нём админами с правом
# приглашать и банить. Узнать ID: добавь админ-бота в канал и напиши
# в админ-боте /chanhelp — он подскажет, как получить ID.
CHANNEL_ID=-1001234567890

# (необязательно) ID чата-группы, если пускать ещё и в чат. Пусто = только канал.
# Бот должен быть админом и в чате (права: приглашать + банить).
CHAT_ID=

# ── Доступ ──────────────────────────────────────────────────────────────
# Твой Telegram user_id (узнать: напиши админ-боту /whoami). Через запятую.
ADMIN_IDS=1350559985

# Порог баллов: строго меньше — кандидат на удаление / отказ во входе.
THRESHOLD=50

# ── Хостинг (bothost.ru и т.п.) ─────────────────────────────────────────
# Путь к постоянному диску / общему хранилищу, чтобы store.json НЕ стирался
# при перезапуске. Локально можно не задавать (файл ляжет рядом с кодом).
# На bothost — включи «Общее хранилище» и укажи его путь, например /app/shared.
STORE_DIR=

# Какой(ие) бот(ы) АКТИВНО опрашивает Telegram этот процесс:
#   both   — оба бота в одном процессе (по умолчанию; для одиночного VPS и т.п.)
#   member — только бот участников (нужен только MEMBER_BOT_TOKEN)
#   admin  — только админ-бот (нужен ADMIN_BOT_TOKEN; MEMBER_BOT_TOKEN тоже стоит
#            указать — им админ-бот шлёт участникам ссылки и уведомления)
# Пригождается, когда на хостинге 1 запись = 1 токен (например bothost.ru):
# заводишь ДВЕ записи с одним и тем же кодом, ROLE=member / ROLE=admin,
# и ОБЩИМ STORE_DIR (иначе боты не увидят данные друг друга).
ROLE=both
