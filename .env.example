# Скопируй в .env и впиши свои значения.

# Токен единственного бота из @BotFather.
BOT_TOKEN=123456789:AA-your-bot-token-here

# Кто админ: Telegram id и/или @username через запятую (можно и то, и то).
# Свой user_id — командой /whoami боту.
ADMIN_IDS=
ADMIN_USERNAMES=
# После запуска действующий админ также может добавлять других:
# /addadmin 123456789, /addadmin @username или /addadmin phone +79991234567.
# Первичная настройка: если ADMIN_IDS/ADMIN_USERNAMES пусты — первые N,
# написавших /admin, станут админами. 0 — выключить.
MAX_AUTO_ADMINS=5

# Постоянная папка для store.json. На Bothost /app/data переживает обновления Git.
STORE_DIR=/app/data
# Бот делает снимок после первого изменения и затем не чаще раза в 6 часов.
# Хранится максимум 30 последних снимков в /app/data/backups.
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=30

# PostgreSQL Bothost — рекомендуемый основной способ переживать любые обновления
# и пересоздания контейнера. Вставь полный connection string из раздела «Базы
# данных PostgreSQL». Бот сам создаст таблицу и перенесёт существующий store.json.
DATABASE_URL=
# Обычно менять не нужно. Позволяет нескольким независимым ботам хранить разные
# состояния в одной БД.
POSTGRES_STATE_KEY=main

# ── Авто-пуш из расширения (необязательно) ──────────────────────────────────
# Если заданы оба — бот поднимает HTTP-приём: расширение шлёт баллы прямо боту,
# и тебе приходит уведомление «данные пришли». Пусто — приём выключен, работает
# старый путь (прислать CSV файлом).
#
# INGEST_SECRET — общий секрет для совместимого HTTP-клиента. Текущее Chrome-
# расширение использует приватный Telegram-канал и этот секрет ему не нужен.
#   Придумай длинную случайную строку, например: openssl rand -hex 24
INGEST_SECRET=
# INGEST_PORT — порт HTTP-приёма. На многих хостингах порт задаётся сам
#   переменной PORT — тогда это можно не трогать. Локально: например 8787.
INGEST_PORT=

# ── Приём через канал — вместо HTTP-пуша, если публичного адреса у бота нет.
# Расширение постит CSV в приватный канал, бот забирает его оттуда сам.
# Настройка: создай приватный канал, добавь туда ЭТОГО бота администратором
# (он пришлёт chat_id в личку), а в расширение впиши chat_id и токен ВТОРОГО
# бота-загрузчика. Загрузчик обязан быть другим ботом: своего поста бот в
# Telegram не видит, чужой — видит.
# Можно оставить пустым — тогда бот запомнит первый канал, где его сделали
# админом. Заполненное значение надёжнее: переживает переезд хранилища.
IMPORT_CHANNEL_ID=

# ── Чаты-тиры: каждый чат = свой порог баллов. TIERn_ID можно оставить пустым,
#    пока чат не создан — тогда бот считает/показывает, но не приглашает/не банит.
TIER1_NAME=Бережное врачевание чат №1
TIER1_THRESHOLD=50
TIER1_ID=

TIER2_NAME=Бережное врачевание чат №2
TIER2_THRESHOLD=200
TIER2_ID=

# ── Одноразовая первичная очистка старого чата ────────────────────────
# Нужны только для `npm run cleanup:preview` / `cleanup:execute`.
# Получи на https://my.telegram.org → API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Сессия не хранится: каждый preview/execute попросит QR. Если на аккаунте включена 2FA,
# временно задай пароль перед запуском и удали сразу после:
TELEGRAM_2FA_PASSWORD=
# По умолчанию скрипт возьмёт TIER1_ID. Можно задать явно:
PURGE_CHAT_ID=-1001593559029
# Обычные участники, которых надо оставить, через запятую (админы/боты и так защищены):
PURGE_KEEP_USER_IDS=
# Куда сохранить резервные CSV/JSON перед очисткой:
PURGE_EXPORT_DIR=cleanup-plans
