# Один бот на всё (участники + админка). Токен — из @BotFather.
# ⚠️ Этот токен светился в публичном git — ОБЯЗАТЕЛЬНО перевыпусти его в @BotFather
#    (/revoke), затем впиши сюда новый. @username и переписки с людьми сохранятся.
BOT_TOKEN=8911618863:AAFbGxvMSq1agTIJGNFRRiaH6q4WZ5rh7UM

# Кто админ: id и/или @username через запятую. Их бот узнаёт сам — панель даёт
# только им. Свой user_id можно узнать командой /whoami.
ADMIN_IDS=5867346910
ADMIN_USERNAMES=natalishkadoterra,anzhelikadol,iboboeff
# Первичная настройка: если ADMIN_IDS и ADMIN_USERNAMES пусты, первые N человек,
# написавших /admin, станут админами. Пока админы заданы выше — не действует.
MAX_AUTO_ADMINS=5

# Постоянная папка для store.json (на хостинге — общий/постоянный диск).
STORE_DIR=/app/shared

# ── Чат №1 (от 50 баллов) ──
# ⚠️ Сейчас тут ID ТЕСТОВОГО чата «Doterra Event». Для боевого запуска замени на
#    ID настоящего «Бережное врачевание чат №1» (узнать: команда /id в том чате).
TIER1_NAME=Бережное врачевание чат №1
TIER1_THRESHOLD=50
TIER1_ID=-1003634961399

# ── Чат №2 (от 200 баллов) ──
TIER2_NAME=Бережное врачевание чат №2
TIER2_THRESHOLD=200
TIER2_ID=
